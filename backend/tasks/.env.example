# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sudamerica

# JWT (must match api_execute)
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sudamerica.ai
SMTP_FROM_NAME=Sudamerica AI

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
