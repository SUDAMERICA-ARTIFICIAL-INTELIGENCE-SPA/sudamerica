# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sudamerica

# JWT (must match api_execute)
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256

