# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sudamerica

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# Bcrypt
BCRYPT_ROUNDS=12

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Internal service URLs
SERVICE_CALLBACK_URL=http://localhost:8002
SERVICE_TASKS_URL=http://localhost:8003
INTERNAL_SERVICE_TOKEN=

# Logging
LOG_LEVEL=INFO
