# ============================================================
# open_agent — Copiloto Administrativo (port 8005)
# Text generation for customer/onboarding chat + admin tools.
# ============================================================

# JWT (must match the other services)
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256

# Internal service auth
# Own signing key + peer keys this service trusts as issuers.
OPEN_AGENT_INTERNAL_SERVICE_SECRET_KEY=
API_EXECUTE_INTERNAL_SERVICE_SECRET_KEY=
INTERNAL_SERVICE_TOKEN_TTL_SECONDS=300

# Internal service URLs (admin tools call back into api_execute)
SERVICE_API_EXECUTE_URL=http://localhost:8000

# LLM provider — the admin copilot uses a powerful model
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Tool-calling loop limit
MAX_TOOL_CALLS=8

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
