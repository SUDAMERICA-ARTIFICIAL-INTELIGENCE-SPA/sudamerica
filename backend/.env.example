# ============================================================
# Sudamérica AI backend -- shared reference values
# Canonical multi-tenant discriminator: tenant_id
# ============================================================

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Shared database + JWT
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/america_db
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
BCRYPT_ROUNDS=12

# Internal service URLs
SERVICE_API_EXECUTE_URL=http://localhost:8000
SERVICE_AI_DIALER_URL=http://localhost:8001
SERVICE_CALLBACK_MANUAL_URL=http://localhost:8002
SERVICE_TASKS_URL=http://localhost:8003
SERVICE_CANALES_URL=http://localhost:8004

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sudamerica.ai
SMTP_FROM_NAME=Sudamérica AI

# LLM — Standard keys: OPENAI_API_KEY + GEMINI_API_KEY
# Per-tenant overrides via llm_provider_keys table (managed in sudamerica-admin)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Voice / channels
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=
